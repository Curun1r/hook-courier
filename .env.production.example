DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-at-least-fifty-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
HOOKCOURIER_API_KEY=change-this-to-a-random-api-key-at-least-thirty-two-characters
POSTGRES_DB=hookcourier
POSTGRES_USER=hookcourier
POSTGRES_PASSWORD=change-this-to-a-random-database-password
DB_HOST=db
DB_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
DJANGO_HTTPS=1
DJANGO_TRUST_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=
HOOKCOURIER_HTTP_PORT=18001
WEB_CONCURRENCY=2
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_BYTES=65536
WEBHOOK_RETRY_BASE_SECONDS=2
WEBHOOK_RETRY_MAX_SECONDS=60
WEBHOOK_DEADLINE_SECONDS=15
